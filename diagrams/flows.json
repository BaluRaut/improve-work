  "poker": {
    "title": "Planning poker: reveal together, talk about the gaps, vote again.",
    "direction": "TB",
    "nodes": [
      {
        "id": "A",
        "label": "Feature owner reads the item\nand acceptance criteria",
        "kind": "step"
      },
      {
        "id": "B",
        "label": "Questions first,\nno numbers yet",
        "kind": "step"
      },
      {
        "id": "C",
