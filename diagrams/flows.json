  "sizing": {
    "title": "Pick the size: ask in order and stop at the first yes.",
    "direction": "TB",
    "nodes": [
      {
        "id": "Q1",
        "label": "1. Touches login, permissions, money,\npersonal data or a production data migration?",
        "kind": "decision"
      },
      {
        "id": "Q2",
        "label": "2. Can it only ship if several teams deliver\nwork that depends on each other?",
        "kind": "decision"
      },
      {
        "id": "Q3",
        "label": "3. Needs a technical choice, a new API, table\nor infrastructure, or more than a few stories?",
        "kind": "decision"
      },
      {
        "id": "FULL",
        "label": "Full",
        "kind": "result",
        "tone": "full"
      },
      {
