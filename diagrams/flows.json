        "id": "E",
        "label": "Highest and lowest\nvoters explain why",
        "kind": "step"
      },
      {
        "id": "S",
        "label": "Split it, spike first,\nor back to refinement",
        "kind": "result",
        "tone": "full"
      },
      {
        "id": "F",
        "label": "Vote again",
        "kind": "step"
      },
      {
        "id": "G",
        "label": "Agree now?",
        "kind": "decision"
      },
      {
        "id": "H",
        "label": "Take the higher number\nor split the item",
        "kind": "step"
      }
